# Copy to .env and adjust. Never commit .env.
#
# One file serves both setups:
#   - Docker (self-hosting): `docker compose up -d --build` from the repo root reads it; the server
#     container receives every variable in it.
#   - Development: devenv auto-loads it. Leave the database out of it -- devenv derives
#     DATABASE_URL from the Postgres port it allocated.
#
# Values are checked at startup: a number that doesn't parse, or a flag that isn't one of
# 1/0, true/false, yes/no, on/off, stops the server with an error naming the variable. An empty
# value counts as unset. Commented-out lines show the default.

# =================================================================================================
# Required
# =================================================================================================

# Postgres password for the compose `db` service; the server's DATABASE_URL is built from it.
# It goes into a URL, so stick to URL-safe characters, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=
# Signs the access tokens: at least 32 bytes, and not a placeholder. Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# =================================================================================================
# Docker compose
# =================================================================================================

POSTGRES_USER=atlas
POSTGRES_DB=atlas
# Host address and port the server is published on (inside the container it always listens on
# 8080). The default, localhost only, suits a reverse proxy on the same host; 8080 listens on every
# interface.
# PORT_BIND=127.0.0.1:8080
# Image to run. `docker compose up -d --build` builds it from this checkout under this name;
# `docker compose pull` fetches it instead. Pin a version tag in production.
# ATLAS_IMAGE=ghcr.io/atlastodo/atlas-todo:latest
# Name of the Postgres data volume. The default keeps the name older installs already have. A
# deployment that runs compose with its own project name (`-p <name>`, as Dokploy does) has a
# volume called <name>_atlas_db: set that here, or it starts on a new, empty database.
# ATLAS_DB_VOLUME=docker_atlas_db

# =================================================================================================
# Server
# =================================================================================================

# Listening port. Compose pins it to 8080 inside the container; use PORT_BIND there instead.
# PORT=8080
# Listening address: any IPv4 or IPv6 address (127.0.0.1 for localhost only, :: for every IPv6
# and, on most hosts, IPv4 interface). Compose pins it to 0.0.0.0 inside the container.
# BIND_ADDR=0.0.0.0
# PostgreSQL connections the server pools. Sync writes queue on one lock, each holding one.
# DB_MAX_CONNECTIONS=10
# Log filter (tracing EnvFilter syntax). The Docker image defaults to `info`; a bare binary
# defaults to `atlas_server=info,warn`.
# RUST_LOG=info
# Directory of the exported web app to serve. The Docker image sets /app/dist; unset elsewhere
# means API only.
# STATIC_DIR=/app/dist
# Comma-separated exact origins allowed to call the API from a browser. Unset allows any origin
# (auth is a Bearer header, not a cookie, so this is safe and keeps self-hosting turnkey).
# CORS_ALLOWED_ORIGINS=https://todo.example.com,https://app.todo.example.com

# --- Auth ------------------------------------------------------------------------------------
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Accounts and admin --------------------------------------------------------------------
# Set to false to refuse new accounts (POST /auth/signup answers 403 signup_disabled); existing
# accounts keep signing in, and a signup invite still admits one person. This is only the
# default: the admin panel's toggle, once used, overrides it.
# SIGNUP_ENABLED=true
# Comma-separated emails promoted to admin at every startup, if the account exists. It never
# demotes anyone and grants nothing at signup. For the first admin: sign up, then restart, or run
#   docker compose exec server atlas-server promote you@example.com
# ADMIN_EMAILS=you@example.com
# Set to false to unmount the anonymous bug-report endpoint (POST /reports), e.g. when nobody
# reads the /admin reports page.
# BUG_REPORTS_ENABLED=true
# Comma-separated Atlas apps this instance offers, from those bundled in the server release (todo
# and journal; todo,journal also offers Atlas Journal). An app the release does not bundle refuses
# to start. Sync refuses and hides the data of an app left out; GET /discovery lists the ones
# offered.
# ATLAS_APPS=todo

# --- Passkeys -------------------------------------------------------------------------------
# Passkeys sign in and unlock the account (WebAuthn with the PRF extension). Off unless
# WEBAUTHN_RP_ID is set: the domain passkeys belong to, normally the one serving the web app.
# Changing it later orphans every passkey already registered.
# WEBAUTHN_RP_ID=todo.example.com
# Comma-separated exact origins a ceremony may come from. Default https://<WEBAUTHN_RP_ID>; each
# must be https on that domain or a subdomain (http://localhost only with WEBAUTHN_RP_ID=localhost).
# WEBAUTHN_ORIGINS=https://todo.example.com
# Shown by the authenticator next to the passkey.
# WEBAUTHN_RP_NAME=Atlas Todo
# Android app passkeys: served as /.well-known/assetlinks.json on WEBAUTHN_RP_ID's domain, and
# added to the allowed origins. Both or neither. The fingerprint is the SHA-256 of the app's
# signing certificate (for Play builds, the app signing key shown in the Play Console).
# ANDROID_APP_PACKAGE=dev.sejder.atlastodo
# ANDROID_APP_CERT_SHA256=AB:CD:...:EF

# --- Behind a reverse proxy -----------------------------------------------------------------
# Trust the proxy's X-Forwarded-For for per-IP rate limits. Off by default, because without a
# proxy the client writes that header itself. Behind a proxy, turn it on: otherwise every client
# shares the proxy's address and one login budget.
# AUTH_RATE_LIMIT_TRUST_FORWARDED=false
# How many proxies append to X-Forwarded-For (at least 1).
# TRUSTED_PROXY_HOPS=1
#
# Proxy body size: attachments are uploaded in one request of up to MAX_BLOB_BYTES, and a sync
# push can reach MAX_PUSH_BYTES. nginx's default `client_max_body_size` is 1 MiB, which breaks
# both -- raise it above MAX_BLOB_BYTES (e.g. `client_max_body_size 30m;`). nginx also needs the
# WebSocket upgrade headers for /sync/ws. Caddy needs neither change.

# --- Rate limits ------------------------------------------------------------------------------
# Per client IP on the auth endpoints (signup, login, refresh, ...).
# AUTH_RATE_LIMIT_MAX=30
# AUTH_RATE_LIMIT_WINDOW_SECS=60
# Failed password checks per account and client address (an IPv6 /64), across login, recovery
# and cancel-deletion. Across all addresses an account closes at five times this.
# AUTH_ACCOUNT_FAILURE_MAX=10
# AUTH_ACCOUNT_FAILURE_WINDOW_SECS=900
# Per user on sync pushes.
# SYNC_RATE_LIMIT_MAX=60
# SYNC_RATE_LIMIT_WINDOW_SECS=60
# Per user on sync reads (pull, snapshot, WebSocket tickets).
# SYNC_READ_RATE_LIMIT_MAX=600
# SYNC_READ_RATE_LIMIT_WINDOW_SECS=60
# Per client IP on POST /reports (anonymous, so its own tight bucket).
# REPORT_RATE_LIMIT_MAX=10
# REPORT_RATE_LIMIT_WINDOW_SECS=300
# Per user on project invites (each one shows whether an email has an account).
# INVITE_RATE_LIMIT_MAX=60
# INVITE_RATE_LIMIT_WINDOW_SECS=3600
# Per user on attachment uploads.
# UPLOAD_RATE_LIMIT_MAX=60
# UPLOAD_RATE_LIMIT_WINDOW_SECS=60
# Per user on attachment downloads (a separate budget, so opening files never blocks uploads).
# DOWNLOAD_RATE_LIMIT_MAX=600
# DOWNLOAD_RATE_LIMIT_WINDOW_SECS=60

# --- Sync -----------------------------------------------------------------------------------
# Largest accepted POST /sync/push body in bytes (2 MiB); a larger one answers 413.
# MAX_PUSH_BYTES=2097152
# Days of sync-operation history to keep; 0 disables the purge.
# OP_RETENTION_DAYS=30
# Days an expired or revoked refresh token is kept (for reuse detection); 0 or less disables.
# REFRESH_TOKEN_RETENTION_DAYS=30

# --- Attachments ----------------------------------------------------------------------------
# Set to false to turn attachments off: /attachments/* then answers 404 and clients hide the
# feature.
# ATTACHMENTS_ENABLED=true
# Storage backend: `fs` (files under BLOB_DIR) or `s3` (an S3 or S3-compatible bucket).
# BLOB_BACKEND=fs
# Blob directory. In Docker keep it under /app/data, the volume; anything else is lost when the
# container is recreated. With BLOB_BACKEND=s3 it only holds uploads in progress.
# BLOB_DIR=/app/data/blobs
# With BLOB_BACKEND=s3: the bucket (required) and an optional key prefix. Credentials, region and
# endpoint use the standard AWS variables; AWS_ENDPOINT points at an S3-compatible service, and
# AWS_ALLOW_HTTP=true permits a plain-http one.
# S3_BUCKET=
# S3_PREFIX=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_ENDPOINT=
# AWS_ALLOW_HTTP=false
# Largest accepted attachment in bytes (25 MiB).
# MAX_BLOB_BYTES=26214400
# Total stored bytes per uploader (1 GiB).
# BLOB_QUOTA_BYTES=1073741824
# Attachment uploads and downloads in progress at once, across all users; one more answers 503
# and the client tries again shortly. Bodies stream to and from disk, so this bounds open files
# and disk load, not memory.
# MAX_BLOB_TRANSFERS=16
# Days an unreferenced blob is kept before garbage collection frees it, counted from its last
# upload and from when it lost its last reference. Never less than OP_RETENTION_DAYS, so a
# deleted attachment can still be restored; 0 disables the collection.
# BLOB_GC_GRACE_DAYS=30
