{
  "name": "@atlas/electron",
  "version": "0.1.10-rc.2",
  "private": true,
  "description": "Atlas Todo desktop application powered by Electron",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/atlastodo/atlas-todo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlastodo/atlas-todo.git",
    "directory": "apps/electron"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "package": "bash ../../scripts/package-desktop.sh",
    "dev": "tsc -p tsconfig.build.json && electron dist/main.js --dev",
    "start": "tsc -p tsconfig.build.json && electron dist/main.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "electron": "^44.6.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  }
}
