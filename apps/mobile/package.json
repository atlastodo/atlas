{
  "name": "@atlas/mobile",
  "version": "0.1.10-rc.3",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlastodo/atlas-todo.git",
    "directory": "apps/mobile"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "bunx eas-cli build --profile preview --platform android",
    "build:android:local": "bunx eas-cli build --profile preview --platform android --local",
    "build:android:aab": "EAS_BUILD_NO_EXPO_GO_WARNING=true bunx eas-cli build --profile production --platform android --local",
    "bundle:release": "cd android && ./gradlew bundleRelease",
    "build:ios": "bunx eas-cli build --profile preview --platform ios",
    "build:ios:local": "bunx eas-cli build --profile preview --platform ios --local",
    "update:preview": "bunx eas-cli update --channel preview",
    "export:web": "expo export --platform web && node scripts/postexport-favicon.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -f build-*.apk build-*.aab && rm -rf .expo dist && (rm -rf android/app/build android/build 2>/dev/null || true)"
  },
  "dependencies": {
    "@atlas/client-core": "workspace:*",
    "@atlas/shared": "workspace:*",
    "@expo/metro-runtime": "~57.0.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.5",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-navigation-bar": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "hash-wasm": "^4.12.0",
    "i18next": "^26.4.2",
    "lucide-react-native": "^1.49.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.7",
    "react-native-reanimated": "4.5.1",
    "react-native-reorderable-list": "0.18.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/runtime": "^8.0.7",
    "@googleapis/androidpublisher": "^42.2.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~57.0.14",
    "fake-indexeddb": "^6.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "tailwindcss": "^3.4.19",
    "test-renderer": "~1.3.0",
    "typescript": "~7.0.2"
  }
}
