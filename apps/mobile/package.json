{
  "name": "@atlastodo/mobile",
  "version": "0.1.11-rc.5",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlastodo/atlas-todo.git",
    "directory": "apps/mobile"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "bunx eas-cli build --profile preview --platform android",
    "build:android:local": "bunx eas-cli build --profile preview --platform android --local",
    "build:android:aab": "EAS_BUILD_NO_EXPO_GO_WARNING=true bunx eas-cli build --profile production --platform android --local",
    "bundle:release": "cd android && ./gradlew bundleRelease",
    "build:ios": "bunx eas-cli build --profile preview --platform ios",
    "build:ios:local": "bunx eas-cli build --profile preview --platform ios --local",
    "update:preview": "bunx eas-cli update --channel preview",
    "export:web": "expo export --platform web && node scripts/postexport-favicon.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -f build-*.apk build-*.aab && rm -rf .expo dist && (rm -rf android/app/build android/build 2>/dev/null || true)"
  },
  "dependencies": {
    "@atlastodo/client-core": "workspace:*",
    "@atlastodo/shared": "workspace:*",
    "@expo/metro-runtime": "~58.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.0",
    "expo-application": "~58.1.1",
    "expo-audio": "~58.0.9",
    "expo-build-properties": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.6",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-haptics": "~58.0.6",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.4",
    "expo-router": "~58.0.21",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.18",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "hash-wasm": "^4.12.0",
    "i18next": "^26.4.4",
    "lucide-react-native": "^1.55.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.16",
    "react-native": "0.88.0",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.8",
    "react-native-reanimated": "4.7.1",
    "react-native-reorderable-list": "0.18.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/runtime": "^8.0.7",
    "@googleapis/androidpublisher": "^42.2.0",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.2.3",
    "babel-jest": "^30.5.2",
    "babel-preset-expo": "~58.0.0",
    "fake-indexeddb": "^6.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-expo": "~58.0.11",
    "tailwindcss": "^3.4.19",
    "test-renderer": "~1.3.0",
    "typescript": "~7.0.2"
  }
}
