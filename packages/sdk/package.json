{
  "name": "@atlastodo/sdk",
  "version": "0.1.15",
  "description": "Headless Atlas client for integrations: API-token sessions that sync an account into memory (the apps' own clients, such as the vault's VaultClient, sit on top)",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/atlastodo/atlas/tree/main/packages/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlastodo/atlas.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/atlastodo/atlas/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@atlastodo/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@atlastodo/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./test-vectors/*": "./test-vectors/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "test-vectors"
  ],
  "publishConfig": {
    "access": "public"
  },
  "atlas": {
    "testVectors": [
      "scope_rule_vectors.json"
    ]
  },
  "scripts": {
    "build": "bun ../../scripts/build-core-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlastodo/client-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
