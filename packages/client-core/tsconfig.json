{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // The sibling packages from their sources (package.json `exports`), not a built dist/.
    "customConditions": ["@atlastodo/source"],
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"],
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
