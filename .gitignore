# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# Rust
/target
**/*.rs.bk

# Node / Bun
node_modules/
dist/
dist-packages/
# A core package's pack output (scripts/build-core-package.mjs): its tarball, the fixtures copied
# from test-vectors/ and the copied licence. dist/ is covered above.
atlastodo-*.tgz
/packages/*/test-vectors/
/packages/*/LICENSE
# nix build outputs
result
result-*
*.tsbuildinfo
bun.lockb.tmp


# Env / secrets
.env
.env.*
!.env.example
*.local

# Signing keystores never belong in the repo
*.jks
*.keystore

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
.claude/
.opencode/

# Local agent tooling state
/.agents/

# Generated by scripts/third-party-licenses.mjs (CI and release builds)
THIRD_PARTY_NOTICES.txt
