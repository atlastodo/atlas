{
  "_doc": "App definitions and the scope engine (docs/architecture.md, App definitions), asserted by packages/client-core (scopeRules.test.ts) and crates/atlas-client (registry.rs) alike. `definition` is a test app shaped like todo, with kinds core has no code for (`vector_note`, two hops; `vector_tag`, no rule); core's own tests register it. A case's `expected` is `personal`, `unknown` or `project:<id>`. `invalid` lists definitions both sides must refuse.",
  "definition": {
    "app": "todo",
    "kinds": {
      "task": { "scope": [{ "field": "project_id" }] },
      "section": { "scope": [{ "field": "project_id" }] },
      "comment": { "scope": [{ "field": "task_id", "kind": "task" }] },
      "activity": {
        "scope": [{ "field": "task_id", "kind": "task" }, { "field": "project_id" }],
        "actor_field": "actor_id"
      },
      "attachment": { "scope": [{ "field": "task_id", "kind": "task" }] },
      "vector_note": {
        "scope": [
          { "field": "comment_id", "kind": "comment" },
          { "field": "section_id", "kind": "section" }
        ]
      },
      "vector_tag": {}
    }
  },
  "wire": [
    { "kind": "task", "wire": "todo.sealed" },
    { "kind": "project", "wire": "todo.project" },
    { "kind": "vector_note", "wire": "todo.sealed" },
    { "kind": "vector_tag", "wire": "todo.sealed" },
    { "kind": "journal.entry", "wire": "journal.sealed" },
    { "kind": "unregistered_kind", "wire": null }
  ],
  "actor_fields": [
    { "kind": "activity", "field": "actor_id" },
    { "kind": "comment", "field": null },
    { "kind": "vector_note", "field": null }
  ],
  "link_fields": ["comment_id", "project_id", "section_id", "task_id"],
  "store": [
    { "kind": "project", "id": "p1", "fields": { "name": "P1" } },
    { "kind": "task", "id": "t1", "fields": { "project_id": "p1" } },
    { "kind": "task", "id": "t2", "fields": { "title": "personal" } },
    { "kind": "section", "id": "s1", "fields": { "project_id": "p3" } },
    { "kind": "comment", "id": "c1", "fields": { "task_id": "t1" } },
    { "kind": "comment", "id": "c2", "fields": { "task_id": "t2" } },
    { "kind": "comment", "id": "c3", "fields": { "task_id": "t9" } },
    { "kind": "activity", "id": "a1", "fields": { "task_id": "t1", "project_id": "p2" } },
    { "kind": "activity", "id": "a2", "fields": { "project_id": "p2" } },
    { "kind": "activity", "id": "a3", "fields": { "actor_id": "u1" } },
    { "kind": "vector_note", "id": "n1", "fields": { "comment_id": "c1", "section_id": "s1" } },
    { "kind": "vector_note", "id": "n2", "fields": { "section_id": "s1" } },
    { "kind": "vector_note", "id": "n3", "fields": { "comment_id": "c2" } },
    { "kind": "vector_tag", "id": "g1", "fields": { "project_id": "p1" } },
    { "kind": "label", "id": "l1", "fields": { "project_id": "p1" } },
    { "kind": "journal.entry", "id": "j1", "fields": { "project_id": "p1" } }
  ],
  "cases": [
    { "kind": "project", "id": "p1", "expected": "project:p1" },
    { "kind": "project", "id": "p404", "expected": "project:p404" },
    { "kind": "task", "id": "t1", "expected": "project:p1" },
    { "kind": "task", "id": "t2", "expected": "personal" },
    { "kind": "task", "id": "t9", "expected": "unknown" },
    { "kind": "comment", "id": "c1", "expected": "project:p1" },
    { "kind": "comment", "id": "c2", "expected": "personal" },
    { "kind": "comment", "id": "c3", "expected": "unknown" },
    { "kind": "activity", "id": "a1", "expected": "project:p1" },
    { "kind": "activity", "id": "a2", "expected": "project:p2" },
    { "kind": "activity", "id": "a3", "expected": "personal" },
    { "kind": "vector_note", "id": "n1", "expected": "project:p1" },
    { "kind": "vector_note", "id": "n2", "expected": "project:p3" },
    { "kind": "vector_note", "id": "n3", "expected": "personal" },
    { "kind": "vector_note", "id": "n9", "expected": "unknown" },
    { "kind": "vector_tag", "id": "g1", "expected": "personal" },
    { "kind": "label", "id": "l1", "expected": "personal" },
    { "kind": "journal.entry", "id": "j1", "expected": "personal" }
  ],
  "invalid": [
    { "why": "no bundled manifest", "definition": { "app": "notes", "kinds": { "notes.note": {} } } },
    {
      "why": "another app's kind",
      "definition": { "app": "todo", "kinds": { "journal.entry": {} } }
    },
    {
      "why": "not namespaced",
      "definition": { "app": "journal", "kinds": { "draft": {} } }
    },
    {
      "why": "a new kind on a non-sealed wire kind",
      "definition": { "app": "todo", "kinds": { "vector_board": { "wire": "todo.project" } } }
    },
    {
      "why": "a manifest kind on another wire kind",
      "definition": { "app": "todo", "kinds": { "task": { "wire": "todo.project" } } }
    },
    {
      "why": "self on a sealed kind",
      "definition": { "app": "todo", "kinds": { "vector_board": { "scope": "self" } } }
    },
    {
      "why": "links in an app without share containers",
      "definition": {
        "app": "journal",
        "kinds": { "journal.entry": { "scope": [{ "field": "project_id" }] } }
      }
    },
    {
      "why": "a link to an unknown kind",
      "definition": {
        "app": "todo",
        "kinds": { "vector_note": { "scope": [{ "field": "x_id", "kind": "nothing" }] } }
      }
    },
    {
      "why": "an empty link list",
      "definition": { "app": "todo", "kinds": { "vector_note": { "scope": [] } } }
    },
    {
      "why": "a cycle",
      "definition": {
        "app": "todo",
        "kinds": {
          "vector_a": { "scope": [{ "field": "b_id", "kind": "vector_b" }] },
          "vector_b": { "scope": [{ "field": "a_id", "kind": "vector_a" }] }
        }
      }
    }
  ]
}
