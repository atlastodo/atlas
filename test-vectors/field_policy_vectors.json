    {
      "apps": ["todo"],
      "policy": { "expiry_required": false, "max_lifetime_days": null, "write_by_default": true, "exclusive": false }
    },
    {
      "apps": ["journal"],
      "policy": { "expiry_required": false, "max_lifetime_days": null, "write_by_default": true, "exclusive": false }
    },
    {
      "apps": ["vault"],
      "policy": { "expiry_required": true, "max_lifetime_days": 365, "write_by_default": false, "exclusive": true }
    },
    {
      "apps": ["todo", "journal", "vault"],
      "policy": { "expiry_required": true, "max_lifetime_days": 365, "write_by_default": false, "exclusive": true }
    }
